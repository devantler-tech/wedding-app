{
  "name": "wedding-app",
  "version": "0.0.0",
  "description": "Wedding website for Aimée & Nikolai Emil",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "bundlesize": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "node scripts/lighthouse.mjs",
    "boot-smoke": "node scripts/boot-smoke.mjs",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/lib/server/seed.ts"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.20.3",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.22.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
